from os import PathLike
from typing import Any

StrPath = str | PathLike[str]

class MacCodes:
    def __init__(self, path: StrPath, only: set[str] | None = None) -> None: ...
    @property
    def source_note(self) -> str | None: ...
    def expand(self, locus: str, typing: str) -> list[str]: ...
    def __len__(self) -> int: ...

class Dataset:
    @property
    def loci(self) -> list[str]: ...
    @property
    def ids(self) -> list[str]: ...
    @property
    def alleles(self) -> list[str]: ...
    @property
    def issues(self) -> list[tuple[int, str | None, str]]: ...
    def sample(self, index: int) -> dict[str, str | None]: ...
    def missing_counts(self) -> dict[str, int]: ...
    def one_allele_counts(self) -> dict[str, int]: ...
    def __len__(self) -> int: ...

class Nomenclature:
    def __init__(self, path: StrPath) -> None: ...
    @property
    def source(self) -> str | None: ...
    def translate(self, code: str, resolution: str) -> list[tuple[str, float]]: ...

class Estimate:
    @property
    def loci(self) -> list[str]: ...
    @property
    def resolutions(self) -> list[str]: ...
    @property
    def haplotypes(self) -> list[tuple[str, float]]: ...
    @property
    def iterations(self) -> int: ...
    @property
    def converged(self) -> bool: ...
    @property
    def log_likelihood(self) -> float: ...
    @property
    def history(self) -> list[tuple[float, float]]: ...
    @property
    def n_samples(self) -> int: ...
    @property
    def n_samples_incomplete(self) -> int: ...
    @property
    def n_phenotypes(self) -> int: ...
    @property
    def n_candidates(self) -> int: ...
    @property
    def n_completions(self) -> int: ...
    @property
    def timings(self) -> dict[str, float]: ...
    @property
    def issues(self) -> list[tuple[int, str | None, str]]: ...
    def best_diplotypes(self) -> list[tuple[str, str, str, float]]: ...
    def frequencies(self, cut: float = 1e-6, renormalize: bool = True) -> list[tuple[str, float]]: ...
    def write_frequencies(self, path: StrPath, cut: float = 1e-6, renormalize: bool = True) -> None: ...
    def write_history(self, path: StrPath) -> None: ...

def read_mac(path: StrPath, mac_codes: MacCodes | StrPath | None = None, loci: list[str] | None = None) -> Dataset: ...
def read_glsc(path: StrPath, mac_codes: MacCodes | StrPath | None = None, loci: list[str] | None = None) -> Dataset: ...
def classify_typing(typing: str) -> str | None: ...
def estimate(
    dataset: Dataset,
    nomenclature: Nomenclature,
    resolutions: str | list[str] | dict[str, str] | None = None,
    *,
    epsilon: float = 1e-6,
    max_iterations: int = 100_000,
    init: str = "numberOccurrence",
    seed: int = 0,
    min_genotype_frequency: float = 1e-5,
    max_completions: int = 10_000,
    threads: int | None = None,
) -> Estimate: ...

Resolutions = str | list[str] | dict[str, str] | None

class FamilyData:
    @property
    def dataset(self) -> Dataset: ...
    @property
    def loci(self) -> list[str]: ...
    def families(self) -> list[dict[str, Any]]: ...
    @property
    def unrelated(self) -> list[str]: ...
    @property
    def issues(self) -> list[tuple[int, str | None, str]]: ...
    def __len__(self) -> int: ...

class FamilyPhase:
    @property
    def family(self) -> str: ...
    @property
    def father(self) -> str | None: ...
    @property
    def mother(self) -> str | None: ...
    @property
    def haplotypes(self) -> list[str]: ...  # [A, B, C, D]
    @property
    def labelled_haplotypes(self) -> dict[str, str]: ...  # {"A": ..., "B": ..., "C": ..., "D": ...}
    @property
    def children(self) -> list[tuple[str, str | None, str | None]]: ...  # (sample, "A"/"B", "C"/"D")
    @property
    def inconsistent_loci(self) -> list[str]: ...
    @property
    def ambiguous_loci(self) -> list[str]: ...
    @property
    def status(self) -> str: ...
    @property
    def notes(self) -> list[str]: ...
    def parent_id(self, parent: int) -> str: ...

def read_family_table(
    path: StrPath, mac_codes: MacCodes | StrPath | None = None, loci: list[str] | None = None
) -> FamilyData: ...
def check_mendelian(
    data: FamilyData, nomenclature: Nomenclature, resolutions: Resolutions = None
) -> list[dict[str, Any]]: ...
def phase_families(
    data: FamilyData, nomenclature: Nomenclature, resolutions: Resolutions = None
) -> list[FamilyPhase]: ...
def estimate_families(
    data: FamilyData,
    nomenclature: Nomenclature,
    resolutions: Resolutions = None,
    *,
    use_family_phase: bool = True,
    epsilon: float = 1e-6,
    max_iterations: int = 100_000,
    init: str = "numberOccurrence",
    seed: int = 0,
    min_genotype_frequency: float = 1e-5,
    max_completions: int = 10_000,
    threads: int | None = None,
) -> tuple[Estimate, list[FamilyPhase]]: ...
def compare_to_families(estimate: Estimate, phases: list[FamilyPhase]) -> dict[str, Any]: ...
def audit_families(
    data: FamilyData,
    nomenclature: Nomenclature,
    resolutions: Resolutions = None,
    *,
    min_exclusions: int = 2,
    duplicate_fraction: float = 0.9,
    min_loci_compared: int = 5,
    cross_family_duplicates: bool = False,
) -> list[dict[str, Any]]: ...
